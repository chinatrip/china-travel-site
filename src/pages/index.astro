---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideCard from '../components/GuideCard.astro';
import { getCollection } from 'astro:content';
import { buildWebsiteSchema, buildOrganizationSchema } from '../lib/home-schema.mjs';

const guides = await getCollection('guides', ({ data }) => data.status === 'audited');
const apps = await getCollection('apps', ({ data }) => data.status === 'audited');
const totalGuides = guides.length + apps.length;

// "Start here" — the three things foreign visitors ask about most, pulled to the
// top of the page so they aren't lost in the full guide grid. Payment leads
// (the most universal pain point); each id must be an audited guide or it's
// silently skipped. These are excluded from the grid below to avoid duplication.
const FEATURED_IDS = ['mobile-payment', 'visa-types', 'payment-failures'];
const featuredGuides = FEATURED_IDS
  .map((id) => guides.find((g) => g.id === id))
  .filter(Boolean);
const restGuides = guides.filter((g) => !FEATURED_IDS.includes(g.id));

const description = 'Practical travel guides for foreigners visiting China — visa, mobile payment, apps, transportation, food, and safety. Verified from official sources, updated 2026.';
const websiteSchema = buildWebsiteSchema(description);
const organizationSchema = buildOrganizationSchema(new URL('/og-default.png', Astro.site).href);
---

<BaseLayout title="China Travel Guide for Foreigners" description={description}>
  <!-- Structured Data: brand entity + Sitelinks Searchbox (#7) -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-secondary to-blue-900 text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-4">
        Your practical guide to<br />
        <span class="text-red-400">traveling in China</span>
      </h1>
      <p class="text-lg sm:text-xl text-blue-200 max-w-2xl mb-8">
        Everything foreigners need to know — visa, payments, apps, transport, and more. Verified by real travelers, updated regularly.
      </p>

      <div class="flex flex-wrap gap-6 text-sm text-blue-200">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          {totalGuides} verified guides
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          Re-verified on a rolling schedule
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          Cited from official sources
        </div>
      </div>
    </div>
  </section>

  <!-- Start Here — most-asked essentials pulled to the top (payment leads) -->
  {featuredGuides.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-12">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-secondary">Start here</h2>
        <p class="text-sm text-muted mt-1">The questions foreign visitors ask about most — sort these before you fly.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {featuredGuides.map((guide) => (
          <GuideCard
            title={guide.data.title}
            href={`/guides/${guide.id}/`}
            description={guide.data.description}
            lastVerified={guide.data.last_verified}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Guides Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-secondary">Travel Guides</h2>
      <a href="/guides/" class="text-sm text-primary font-medium hover:underline">View all &rarr;</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {restGuides.map((guide) => (
        <GuideCard
          title={guide.data.title}
          href={`/guides/${guide.id}/`}
          description={guide.data.description}
          lastVerified={guide.data.last_verified}
        />
      ))}
    </div>
  </section>

  <!-- Apps Section -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-secondary">Essential Apps</h2>
      <a href="/apps/" class="text-sm text-primary font-medium hover:underline">View all &rarr;</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {apps.map((app) => (
        <GuideCard
          title={app.data.title}
          href={`/apps/${app.id}/`}
          description={app.data.description}
          lastVerified={app.data.last_verified}
        />
      ))}
    </div>
  </section>
</BaseLayout>
