---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search all China travel guides, app tutorials, and practical tips for foreigners." noindex>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <h1 class="text-3xl font-bold text-secondary mb-6">Search</h1>
    <!--
      pagefind injects an <input> with only a placeholder/title for its
      accessible name — no <label>, no aria-label, no landmark. Wrapping the
      mount point in <search aria-label> gives keyboard and screen-reader users
      a named search landmark to jump to. (<search> has an implicit
      role="search"; the aria-label is its accessible name.)
    -->
    <search aria-label="Search ChinaGuide.ai">
      <div id="search"></div>
    </search>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js" defer></script>
  <script is:inline>
    // pagefind-ui.js is deferred, so it hasn't executed when this inline
    // script parses — but deferred scripts always finish before
    // DOMContentLoaded fires, so PagefindUI is defined by the time
    // initSearch runs via the listener branch below.
    function initSearch() {
      var ui = new PagefindUI({ element: "#search", showSubResults: true });
      // Sitelinks Searchbox lands here as /search/?q=term (see the WebSite
      // SearchAction on the homepage) — run the query instead of showing an
      // empty box. triggerSearch() is the documented PagefindUI instance API.
      var query = new URLSearchParams(location.search).get('q');
      if (query) ui.triggerSearch(query);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch);
    } else {
      initSearch();
    }
  </script>

  <style is:global>
    :root {
      --pagefind-ui-primary: #dc2626;
      --pagefind-ui-text: #1e3a5f;
      --pagefind-ui-border: #e5e7eb;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 8px;
      --pagefind-ui-font: 'Inter', sans-serif;
    }
  </style>
</BaseLayout>
