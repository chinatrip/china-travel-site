---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resolveRecentlyVerified } from '../lib/recent-verified.mjs';

const description =
  'How ChinaGuide.ai sources and verifies its guides: official sources first, dated re-verification, a corrections channel, and AI-assistance disclosure.';

// The freshest slice of the public verification record, to make the "dated
// verification" promise concrete on the policy page itself. Full list at /updates/.
const [guides, apps] = await Promise.all([
  getCollection('guides', ({ data }) => data.status === 'audited'),
  getCollection('apps', ({ data }) => data.status === 'audited'),
]);
const recentlyVerified = resolveRecentlyVerified([...guides, ...apps], { limit: 8 });
---

<BaseLayout title="Editorial Policy" description={description}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-secondary mb-2">Editorial Policy</h1>
      <p class="text-muted text-lg">
        The standards every published page on ChinaGuide.ai is held to.
      </p>
    </header>

    <section class="prose prose-gray max-w-none">
      <p>
        The short version: official sources first, dated verification, fast corrections, and
        honest disclosure about how the content is made.
      </p>

      <h2>Sourcing standards</h2>
      <p>Travel rules are checked against the responsible government authority. A transport operator’s published rules apply to its own service. Each guide links the evidence for the location, date and traveller it describes. Unconfirmed claims are excluded.</p>

      <h2>Updates</h2>
      <ul>
        <li>
          Every guide shows a <strong>"Last verified" date</strong>. That date moves only when the
          page has actually been re-checked against its sources — not when we touch formatting.
        </li>
        <li>
          A guide’s volatility label indicates how quickly its subject can change. The published
          fact records use that classification to calculate when a source check is due.
        </li>
        <li>
          When a rule or process changes, we update the existing guide rather than leaving
          outdated advice up alongside a new post.
        </li>
      </ul>

      <h3>Recently verified</h3>
      <p>The most recent re-checks against sources — the same dates shown on each page:</p>
      <ul>
        {recentlyVerified.map((rec) => (
          <li>
            <a href={rec.url}>{rec.title}</a> — verified {rec.displayDate}
          </li>
        ))}
      </ul>
      <p>
        <a href="/updates/">See the full verification record &rarr;</a>
      </p>

      <h2>Corrections</h2>
      <p>
        Found an error? Email <a href="mailto:support@chinaguide.ai">support@chinaguide.ai</a>.
        Corrections are prioritized over other content work: the page is re-checked against
        current sources, fixed, and its verification date updated.
      </p>

      <h2>AI assistance, disclosed</h2>
      <p>We use AI tools to help draft, research, and review content. Three things keep that honest:</p>
      <ol>
        <li>The standards and final publication decisions are made by people, not models.</li>
        <li>
          Nothing is published until it passes a review gate — every page is marked as audited
          before it goes live, and drafts never ship.
        </li>
        <li>
          For content pull requests, an AI-assisted check can flag an FAQ answer that its page does not support. Editors use the original publications to assess factual accuracy.
        </li>
      </ol>
      <p>
        We would rather tell you exactly how this works than pretend otherwise. What matters is
        the verification standard, and it is enforced regardless of which tools produce a draft.
      </p>

      <p>
        Questions about this policy: <a href="mailto:support@chinaguide.ai">support@chinaguide.ai</a>.
        More about who we are: <a href="/about/">About ChinaGuide.ai</a>.
      </p>
    </section>
  </div>
</BaseLayout>
