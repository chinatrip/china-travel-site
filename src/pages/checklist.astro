---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildItemList } from '../lib/item-list.mjs';

// ItemList of the published guide/app pages this checklist's static overview
// links to, in the order they appear in the prose. Every URL here is a real,
// audited page that the visitor can reach from this page — so the schema
// describes what's actually rendered, not an aspirational set. A HowTo would
// be the wrong type: the page is a curated reference list, not literal
// sequential steps, and Google retired HowTo rich results.
const checklistItemList = buildItemList('China Trip Preparation Checklist', [
  '/guides/visa-types/',
  '/guides/tibet-permits/',
  '/apps/alipay/',
  '/apps/wechat/',
  '/guides/mobile-payment/',
  '/guides/sim-card/',
  '/apps/amap/',
  '/guides/accommodation/',
]);
---

<BaseLayout title="China Readiness Checklist" description="Personalized pre-trip checklist for China: visa, payments, apps, connectivity, and more — based on your planned entry route, dates, and destinations.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <script type="application/ld+json" set:html={JSON.stringify(checklistItemList)} />

    <h1 class="text-3xl sm:text-4xl font-bold text-secondary mb-2">China Readiness Checklist</h1>
    <p class="text-muted text-lg mb-8">Tell us about your trip and we'll generate a personalized preparation checklist.</p>

    <!-- Form -->
    <div id="form-section" class="bg-white rounded-xl border border-gray-200 p-6 mb-8 shadow-sm">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Nationality -->
        <div>
          <label for="nationality" class="block text-sm font-medium text-gray-700 mb-1">Your planned entry route</label>
          <select id="nationality" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary">
            <option value="">Select an entry route…</option>
            <option value="visa-free-30">A visa exemption may cover my visit</option>
            <option value="transit-240">I plan to use visa-free transit</option>
            <option value="unsure">I need to check my options</option>
            <option value="visa-required">I plan to apply for a visa</option>
          </select>
        </div>

        <!-- Departure date -->
        <div>
          <label for="departure" class="block text-sm font-medium text-gray-700 mb-1">Departure date</label>
          <input type="date" id="departure" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary" />
        </div>

        <!-- Cities -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Destinations (select all)</label>
          <div class="flex flex-wrap gap-2">
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="beijing" class="city-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Beijing</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="shanghai" class="city-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Shanghai</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="chengdu" class="city-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Chengdu</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="guangzhou" class="city-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Guangzhou</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="xian" class="city-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Xi'an</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="tibet" class="city-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Tibet</label>
          </div>
        </div>

        <!-- Concerns -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Main concerns</label>
          <div class="flex flex-wrap gap-2">
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="connectivity" class="concern-check rounded border-gray-300 text-primary focus:ring-primary/50" checked /> Internet</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="payment" class="concern-check rounded border-gray-300 text-primary focus:ring-primary/50" checked /> Payment</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="transport" class="concern-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Transport</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="accommodation" class="concern-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Hotels</label>
            <label class="inline-flex items-center gap-1.5 text-sm"><input type="checkbox" value="health" class="concern-check rounded border-gray-300 text-primary focus:ring-primary/50" /> Health</label>
          </div>
        </div>
      </div>

      <button id="generate-btn" class="mt-6 w-full sm:w-auto px-6 py-2.5 bg-primary text-white font-medium rounded-lg hover:bg-red-700 transition-colors">
        Generate My Checklist
      </button>
    </div>

    <!-- Static overview (always-visible HTML so the page is indexable without JS) -->
    <section aria-labelledby="checklist-overview-heading" class="mb-8">
      <h2 id="checklist-overview-heading" class="text-xl font-semibold text-secondary mb-3">What this China travel checklist covers</h2>
      <p>Start with the <a href="/guides/visa-types/">entry guide</a>. Check your passport, travel purpose, dates and route before buying tickets. If your route includes Tibet, read the <a href="/guides/tibet-permits/">permit guide</a>.</p>
      <p>Use the <a href="/guides/mobile-payment/">payment guide</a> to compare <a href="/apps/alipay/">Alipay</a> and <a href="/apps/wechat/">WeChat Pay</a>. Check <a href="/guides/sim-card/">mobile service</a>, save directions in <a href="/apps/amap/">Amap</a>, and confirm the arrangements for your <a href="/guides/accommodation/">accommodation</a>.</p>
      <p>For daily use, choose <a href="/apps/alipay/">Alipay</a> or <a href="/apps/wechat/">WeChat</a> for payments, <a href="/apps/amap/">Amap</a> for directions and <a href="/apps/meituan/">Meituan</a> for food delivery. Save your <a href="/guides/accommodation/">hotel details</a> and check <a href="/guides/sim-card/">mobile service</a> before landing.</p>
    </section>

    <!-- Results -->
    <div id="results-section" class="hidden">
      <!-- Progress bar -->
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-48 h-2 bg-gray-200 rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-primary rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <span id="progress-text" class="text-sm text-muted">0 / 0 completed</span>
        </div>
        <button id="reset-btn" class="text-sm text-muted hover:text-primary transition-colors">Reset</button>
      </div>

      <!-- Checklist items rendered here -->
      <div id="checklist-container"></div>
    </div>
  </div>

  <script is:inline>
  (function() {
    const STORAGE_KEY = 'chinaguide_checklist';

    // Keep internal links on the canonical trailing-slash form (avoids a 307 on click).
    const withSlash = (u) => {
      if (!u || !u.startsWith('/')) return u;
      const i = u.search(/[#?]/);
      const path = i === -1 ? u : u.slice(0, i);
      const rest = i === -1 ? '' : u.slice(i);
      if (path.endsWith('/') || path.split('/').pop().includes('.')) return u;
      return path + '/' + rest;
    };

    const allItems = [
      { id: 'visa-free-confirm', category: 'visa', title: 'Check the exemption for your passport', description: 'Match the purpose, length of stay and travel dates to the applicable exemption.', link: '/guides/visa-types/', conditions: { nationalities: ['visa-free-30'] }, priority: 'high' },
      { id: 'visa-transit-confirm', category: 'visa', title: 'Check each stop on your transit route', description: 'Confirm the entry and exit ports, onward ticket and permitted stay area.', link: '/guides/china-transit-area-check/', conditions: { nationalities: ['transit-240'] }, priority: 'high' },
      { id: 'visa-apply', category: 'visa', title: 'Check the tourist visa checklist', description: 'Use the instructions of the office accepting your application.', link: '/guides/visa-types/', conditions: { nationalities: ['visa-required'] }, priority: 'high' },
      { id: 'passport-validity', category: 'visa', title: 'Check your passport and entry route', description: 'Use the passport-validity rule for your own route and travel dates.', link: '/guides/visa-types/', priority: 'high' },
      { id: 'hotel-confirmation', category: 'accommodation', title: 'Confirm your hotel booking', description: 'Ask about the check-in document and accepted payment method.', link: '/guides/accommodation/', conditions: { concerns: ['accommodation'] }, priority: 'high' },
      { id: 'esim-buy', category: 'connectivity', title: 'Check your mobile plan', description: 'Ask the operator which service it can activate for your handset and travel dates.', link: '/guides/sim-card/', conditions: { concerns: ['connectivity'] }, priority: 'high' },
      { id: 'vpn-setup', category: 'connectivity', title: 'Plan access to essential services', description: 'Ask your provider and, for work travel, your employer about supported connections. Keep an offline copy of important information.', link: '/guides/internet-connectivity/', conditions: { concerns: ['connectivity'] }, priority: 'high' },
      { id: 'offline-maps', category: 'connectivity', title: 'Save a route for offline use', description: 'Save the hotel address and the last part of the route. Test your saved map or screenshot with mobile data off.', link: '/apps/amap/', conditions: { concerns: ['connectivity'] }, priority: 'medium' },
      { id: 'translation-app', category: 'connectivity', title: 'Try a translation app', description: 'Try translating a menu photo or speaking an address. Save important phrases in both languages.', link: '/guides/language-barrier/', conditions: { concerns: ['connectivity'] }, priority: 'medium' },
      { id: 'payment-learn', category: 'payment', title: 'Check card support and fees', description: 'Compare linked-card fees at checkout and check your issuer’s own charges.', link: '/guides/mobile-payment/', conditions: { concerns: ['payment'] }, priority: 'high' },
      { id: 'alipay-setup', category: 'payment', title: 'Set up Alipay for merchant payments', description: 'Register and follow the card-linking prompts while you can receive verification messages.', link: '/apps/alipay/', conditions: { concerns: ['payment'] }, priority: 'high' },
      { id: 'wechat-setup', category: 'payment', title: 'Set up WeChat Pay if you plan to use it', description: 'Check card support with your issuer and check the fee shown for your purchase.', link: '/apps/wechat/', conditions: { concerns: ['payment'] }, priority: 'high' },
      { id: 'cash-prepare', category: 'payment', title: 'Prepare a payment backup', description: 'Carry some RMB in smaller notes if convenient. Choose the amount to fit your plans.', link: '/guides/foreign-exchange/', conditions: { concerns: ['payment'] }, priority: 'medium' },
      { id: 'bank-notify', category: 'payment', title: 'Check travel settings with your bank', description: 'Save the support number and ask about overseas use, verification and fees.', link: '/guides/payment-failures/', conditions: { concerns: ['payment'] }, priority: 'medium' },
      { id: 'app-alipay', category: 'apps', title: 'Install Alipay (支付宝) for payments', description: 'Follow the setup guide if you plan to scan merchant payment codes.', link: '/apps/alipay/', priority: 'high' },
      { id: 'app-wechat', category: 'apps', title: 'Install WeChat (微信) for messaging', description: 'Exchange contact details with a host or companion before travelling.', link: '/apps/wechat/', priority: 'high' },
      { id: 'app-amap', category: 'apps', title: 'Save your destination in Amap', description: 'Keep the Chinese name and address of your accommodation for the journey.', link: '/apps/amap/', priority: 'high' },
      { id: 'app-didi', category: 'apps', title: 'Install DiDi (滴滴出行) to book rides', description: 'Save the Chinese destination and check the pickup point in the app.', link: '/apps/didi/', priority: 'medium' },
      { id: 'app-12306', category: 'apps', title: 'Use Railway 12306 (铁路12306) for train tickets', description: 'Check the exact station and the identity document on your booking.', link: '/apps/12306/', conditions: { concerns: ['transport'] }, priority: 'medium' },
      { id: 'app-meituan', category: 'apps', title: 'Install Meituan (美团) for food delivery', description: 'Tap 外卖 to browse nearby restaurants. Ask where your accommodation accepts deliveries.', link: '/apps/meituan/', priority: 'low' },
      { id: '12306-register', category: 'transport', title: 'Prepare for a rail booking', description: 'Carry the original document you used to buy your ticket.', link: '/apps/12306/', conditions: { concerns: ['transport'] }, priority: 'high' },
      { id: 'metro-payment', category: 'transport', title: 'Choose how to pay for a metro ride', description: 'Look up local ticket options, first and last trains, and the station exit you need.', link: '/guides/transportation/', conditions: { concerns: ['transport'] }, priority: 'medium' },
      { id: 'airport-transfer', category: 'transport', title: 'Arrange your pickup', description: 'Confirm your meeting point and exact destination.', link: '/apps/didi/', conditions: { concerns: ['transport'] }, priority: 'high' },
      { id: 'hotel-foreigner', category: 'accommodation', title: 'Confirm arrival arrangements with the property', description: 'Ask about late check-in, the exact entrance and any deposit so you can plan your arrival.', link: '/guides/accommodation/', conditions: { concerns: ['accommodation'] }, priority: 'high' },
      { id: 'passport-copy', category: 'accommodation', title: 'Keep a secure backup of travel documents', description: 'Save a protected copy separately from your passport and carry the original where required.', link: '/guides/accommodation/', conditions: { concerns: ['accommodation'] }, priority: 'medium' },
      { id: 'travel-insurance', category: 'health', title: 'Check medical coverage', description: 'Ask your insurer about treatment and evacuation for your itinerary.', link: '/guides/health-medical/', conditions: { concerns: ['health'] }, priority: 'high' },
      { id: 'emergency-numbers', category: 'health', title: 'Save emergency numbers', description: 'Save 110 for police, 119 for fire and 120 for emergency medical assistance.', link: '/guides/emergency-safety/', conditions: { concerns: ['health'] }, priority: 'high' },
      { id: 'vaccines-check', category: 'health', title: 'Discuss travel health before departure', description: 'Give a travel clinician your itinerary, planned activities and vaccination history.', link: '/guides/health-medical/', conditions: { concerns: ['health'] }, priority: 'medium' },
      { id: 'tibet-permit', category: 'visa', title: 'Check the permit for your Tibet itinerary', description: 'Confirm current requirements for the route and dates before booking.', link: '/guides/tibet-permits/', conditions: { cities: ['tibet'] }, priority: 'high' },
      { id: 'tibet-altitude', category: 'health', title: 'Plan for high altitude', description: 'Discuss your route with a travel clinician and check evacuation coverage with your insurer.', link: '/guides/tibet-permits/', conditions: { cities: ['tibet'] }, priority: 'high' },
      { id: 'private-registration', category: 'accommodation', title: 'Plan private accommodation registration', description: 'Decide with your host who will complete registration.', link: '/guides/residence-registration/', conditions: { concerns: ['accommodation'] }, priority: 'high' },
    ];

    const categoryLabels = {
      visa: '🛂 Visa & Entry',
      connectivity: '📶 Internet & Connectivity',
      payment: '💳 Payment Setup',
      apps: '📱 Essential Apps',
      transport: '🚄 Transportation',
      accommodation: '🏨 Accommodation',
      health: '🏥 Health & Safety'
    };

    const categoryOrder = ['visa', 'connectivity', 'payment', 'apps', 'transport', 'accommodation', 'health'];

    function getFormData() {
      const nationality = document.getElementById('nationality').value;
      const departure = document.getElementById('departure').value;
      const cities = Array.from(document.querySelectorAll('.city-check:checked')).map(el => el.value);
      const concerns = Array.from(document.querySelectorAll('.concern-check:checked')).map(el => el.value);
      return { nationality, departure, cities, concerns };
    }

    function filterItems(data) {
      return allItems.filter(item => {
        const cond = item.conditions;
        if (!cond) return true;
        if (cond.nationalities && !cond.nationalities.includes(data.nationality)) return false;
        if (cond.concerns && !cond.concerns.some(c => data.concerns.includes(c))) return false;
        if (cond.cities && !cond.cities.some(c => data.cities.includes(c))) return false;
        return true;
      });
    }

    function getDaysUntil(dateStr) {
      if (!dateStr) return null;
      const diff = (new Date(dateStr) - new Date()) / (1000 * 60 * 60 * 24);
      return Math.ceil(diff);
    }

    function loadChecked() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch { return {}; }
    }

    function saveChecked(checked) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(checked));
    }

    function updateProgress(items, checked) {
      const total = items.length;
      const done = items.filter(i => checked[i.id]).length;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      document.getElementById('progress-bar').style.width = pct + '%';
      document.getElementById('progress-text').textContent = done + ' / ' + total + ' completed';
    }

    function renderChecklist(items, data) {
      const container = document.getElementById('checklist-container');
      const checked = loadChecked();
      const daysUntil = getDaysUntil(data.departure);
      container.innerHTML = '';

      const grouped = {};
      items.forEach(item => {
        if (!grouped[item.category]) grouped[item.category] = [];
        grouped[item.category].push(item);
      });

      categoryOrder.forEach(cat => {
        const catItems = grouped[cat];
        if (!catItems || catItems.length === 0) return;

        const section = document.createElement('div');
        section.className = 'mb-6';
        section.innerHTML = '<h3 class="text-lg font-semibold text-secondary mb-3">' + categoryLabels[cat] + '</h3>';

        const list = document.createElement('div');
        list.className = 'space-y-2';

        catItems.forEach(item => {
          const isChecked = checked[item.id] || false;
          const isUrgent = item.priority === 'high' && daysUntil !== null && daysUntil < 14;

          const div = document.createElement('div');
          div.className = 'flex items-start gap-3 p-3 rounded-lg border transition-colors ' +
            (isChecked ? 'bg-gray-50 border-gray-100' : 'bg-white border-gray-200');

          div.innerHTML =
            '<input type="checkbox" class="mt-1 rounded border-gray-300 text-primary focus:ring-primary/50 checklist-item" data-id="' + item.id + '"' + (isChecked ? ' checked' : '') + ' />' +
            '<div class="flex-1 min-w-0">' +
              '<div class="flex items-center gap-2">' +
                '<span class="text-sm font-medium ' + (isChecked ? 'line-through text-gray-400' : 'text-gray-900') + '">' + item.title + '</span>' +
                (isUrgent && !isChecked ? '<span class="text-xs px-1.5 py-0.5 bg-red-100 text-red-700 rounded font-medium">Urgent</span>' : '') +
              '</div>' +
              '<p class="text-xs text-muted mt-0.5">' + item.description + '</p>' +
            '</div>' +
            (item.link ? '<a href="' + withSlash(item.link) + '" class="shrink-0 text-xs text-primary hover:underline font-medium mt-1">Guide &rarr;</a>' : '');

          list.appendChild(div);
        });

        section.appendChild(list);
        container.appendChild(section);
      });

      // Attach checkbox listeners
      container.querySelectorAll('.checklist-item').forEach(cb => {
        cb.addEventListener('change', function() {
          const id = this.dataset.id;
          const checked = loadChecked();
          checked[id] = this.checked;
          saveChecked(checked);
          renderChecklist(items, data);
        });
      });

      updateProgress(items, checked);
      document.getElementById('results-section').classList.remove('hidden');
    }

    // Generate button
    document.getElementById('generate-btn').addEventListener('click', function() {
      const data = getFormData();
      if (!data.nationality) {
        alert('Please select an entry route or choose the option to check your options.');
        return;
      }
      const items = filterItems(data);
      renderChecklist(items, data);
      document.getElementById('results-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Reset button
    document.getElementById('reset-btn').addEventListener('click', function() {
      localStorage.removeItem(STORAGE_KEY);
      const data = getFormData();
      const items = filterItems(data);
      renderChecklist(items, data);
    });
  })();
  </script>
</BaseLayout>
