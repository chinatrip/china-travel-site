---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import { buildSoftwareApplication } from '../../lib/app-schema.mjs';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ data }) => data.status === 'audited');
  return apps.map((app) => ({
    params: { id: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const { Content } = await render(app);

// Entity-link this app guide to the SoftwareApplication it documents (about node).
const softwareApp = buildSoftwareApplication(app.id);
---

<GuideLayout
  title={app.data.title}
  description={app.data.description}
  date={app.data.date}
  lastVerified={app.data.last_verified || app.data.review?.page_audit || app.data.date}
  verifiedBy={app.data.verified_by}
  verifiedAgainst={app.data.verified_against}
  volatility={app.data.volatility}
  category="app"
  faqs={app.data.faqs}
  related={app.data.related}
  softwareApp={softwareApp}
>
  <Content />
</GuideLayout>
