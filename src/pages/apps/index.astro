---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection } from 'astro:content';
import { buildCollectionPage, buildBreadcrumbList } from '../../lib/item-list.mjs';

const description =
  'The seven apps every China visitor needs — WeChat, Alipay, Amap, DiDi, 12306, Meituan, Ele.me — with setup steps for foreign phones and cards.';

const apps = await getCollection('apps', ({ data }) => data.status === 'audited');

const collectionSchema = buildCollectionPage({
  name: 'Essential Apps for China Travel',
  description,
  route: '/apps/',
  items: apps.map((app) => ({ name: app.data.title, route: `/apps/${app.id}/` })),
});

const breadcrumbSchema = buildBreadcrumbList([
  { name: 'Home', route: '/' },
  { name: 'Essential Apps', route: '/apps/' },
]);
---

<BaseLayout title="Essential Apps" description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <nav class="text-sm text-muted mb-6">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">Essential Apps</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl font-bold text-secondary mb-2">Essential Apps</h1>
      <p class="text-muted text-lg">Apps you should download before arriving in China.</p>
    </header>

    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    <section class="prose prose-gray max-w-none mb-10">
      <h2>Choose an app for your trip</h2>
      <p>For merchant payments see the <a href="/guides/mobile-payment/">mobile payment guide</a>. For a journey, compare <a href="/apps/12306/">rail booking</a>, <a href="/apps/didi/">ride booking</a> and <a href="/apps/amap/">English navigation</a>. Each guide identifies the service and the scope of its published instructions.</p>
    </section>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {apps.map((app) => (
        <GuideCard
          title={app.data.title}
          href={`/apps/${app.id}/`}
          description={app.data.description}
          lastVerified={app.data.last_verified}
        />
      ))}
    </div>
  </div>
</BaseLayout>
