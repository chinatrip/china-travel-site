---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
// Self-hosted Inter (weights actually used by the site). Replaces the
// render-blocking Google Fonts stylesheet (#39).
// Combined per-weight CSS: one @font-face per subset, each with unicode-range,
// so browsers fetch only the subsets a page actually needs. Guide pages with
// pinyin tone marks (e.g. ǒ ǎ ǐ) need latin-ext; do NOT switch these to the
// per-subset files (latin-400.css etc.) — those lack unicode-range and the
// last-declared face would shadow the rest of the family.
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
// Hashed URLs resolved at build time so the above-the-fold weights can be
// preloaded. Latin subset only: it covers the main text path on every page;
// other subsets (latin-ext for pinyin, etc.) load on demand via unicode-range.
import interLatin400Woff2 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interLatin700Woff2 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import '../styles/global.css';
import { localeOf, alternatesFor, OG_LOCALE, DEFAULT_LOCALE } from '../lib/i18n.mjs';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search indexes (e.g. the /search/ shell page). */
  noindex?: boolean;
  /**
   * Social preview image. Per-page override (absolute URL or site-root path);
   * defaults to the existing /og-default.png. Resolved to an absolute URL so
   * OG/Twitter crawlers, which require absolute image URLs, always get one.
   */
  image?: string;
  /**
   * Page locale. Defaults to the locale inferred from the URL prefix
   * (/es/… → es, everything else → en), so callers rarely set it explicitly.
   */
  lang?: string;
}

const { title, description = 'Your practical guide to traveling in China as a foreigner', noindex = false, image = '/og-default.png', lang } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = `${title} | ChinaGuide.ai`;
// Absolute social-image URL (handles both absolute overrides and root-relative paths).
const ogImage = new URL(image, Astro.site).href;

// Locale + hreflang. `lang` defaults to the URL-inferred locale. `alternates`
// is non-null ONLY for pages in the translation registry; every English-only
// page falls back to the historical `en` + `x-default` = canonical pair, so its
// <head> stays byte-identical to the pre-i18n output (no-regression guarantee).
const pageLang = lang ?? localeOf(Astro.url.pathname);
const ogLocale = OG_LOCALE[pageLang] ?? OG_LOCALE[DEFAULT_LOCALE];
const alternates = alternatesFor(Astro.url.pathname);
---

<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    {alternates
      ? alternates.map((a) => (
          <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, Astro.site).href} />
        ))
      : (
        <>
          <link rel="alternate" hreflang="en" href={canonicalURL} />
          <link rel="alternate" hreflang="x-default" href={canonicalURL} />
        </>
      )}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="ChinaGuide.ai" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preload the above-the-fold font weights (body 400, headings 700). crossorigin is required for font preloads even same-origin. -->
    <link rel="preload" href={interLatin400Woff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin700Woff2} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-surface text-gray-900 font-sans antialiased">
    <Navbar />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />
  </body>
</html>
