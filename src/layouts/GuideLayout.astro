---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/Badge.astro';
import GuideCard from '../components/GuideCard.astro';
import { parseRelated } from '../lib/related.mjs';

interface Props {
  title: string;
  description?: string;
  date?: string;
  lastVerified?: string;
  verifiedBy?: string;
  volatility?: string;
  category?: string;
  faqs?: { q: string; a: string }[];
  related?: string[];
}

const { title, description, date, lastVerified, verifiedBy, volatility, category, faqs, related } = Astro.props;

// Resolve frontmatter `related` wiki paths to published pages only —
// entries pointing at unpublished wiki pages are skipped (with a build-time warning),
// self-links are dropped, and duplicate routes are rendered once.
const isPublished = ({ data }: { data: { status: string } }) => data.status === 'audited';
const [publishedGuides, publishedApps] = await Promise.all([
  getCollection('guides', isPublished),
  getCollection('apps', isPublished),
]);
const entriesByCollection = { guides: publishedGuides, apps: publishedApps };

// Current page route in canonical trailing-slash form, for self-link filtering.
const currentRoute = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

interface RelatedLink {
  href: string;
  title: string;
  description?: string;
  lastVerified?: string;
}

const seenRoutes = new Set<string>();
const relatedLinks: RelatedLink[] = [];
for (const wikiPath of related ?? []) {
  const parsed = parseRelated(wikiPath);
  if (!parsed) continue; // summaries/raw/malformed — intentionally no route
  if (parsed.route === currentRoute || seenRoutes.has(parsed.route)) continue;
  const entry = entriesByCollection[parsed.collection].find((e) => e.id === parsed.id);
  if (!entry) {
    // Slug typo or unpublished wiki page — surface it at build time instead of losing the link silently.
    console.warn(`[related] ${currentRoute}: skipping "${wikiPath}" — no published ${parsed.collection} entry "${parsed.id}"`);
    continue;
  }
  seenRoutes.add(parsed.route);
  relatedLinks.push({
    href: parsed.route,
    title: entry.data.title,
    description: entry.data.description,
    lastVerified: entry.data.last_verified,
  });
}

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const formattedDate = lastVerified ? formatDate(lastVerified) : undefined;
const categoryLabel = category === 'app' ? 'Essential Apps' : 'Travel Guides';
const categoryHref = category === 'app' ? '/apps/' : '/guides/';

function toISODate(dateStr: string): string {
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  return d.toISOString().split('T')[0];
}

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  ...(description && { "description": description }),
  ...(date && { "datePublished": toISODate(date) }),
  ...(lastVerified && { "dateModified": toISODate(lastVerified) }),
  "author": { "@type": "Organization", "name": "ChinaGuide.ai", "url": "https://chinaguide.ai" },
  "publisher": { "@type": "Organization", "name": "ChinaGuide.ai", "url": "https://chinaguide.ai" },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://chinaguide.ai/" },
    { "@type": "ListItem", "position": 2, "name": categoryLabel, "item": `https://chinaguide.ai${categoryHref}` },
    { "@type": "ListItem", "position": 3, "name": title },
  ],
};

const hasFaqs = Array.isArray(faqs) && faqs.length > 0;
const faqSchema = hasFaqs
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs!.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    }
  : null;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-muted mb-8 sm:mb-6">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span class="mx-2">/</span>
      <a href={categoryHref} class="hover:text-primary transition-colors">{categoryLabel}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{title}</span>
    </nav>

    <!-- Header -->
    <header class="mb-8 pb-6 border-b border-gray-200">
      <h1 class="text-3xl sm:text-4xl font-bold text-secondary leading-tight mb-4">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-3 text-sm">
        <Badge volatility={volatility} />
        {formattedDate && (
          <span class="text-muted">
            Last verified: {formattedDate}
            {verifiedBy && <span> by <strong>{verifiedBy}</strong></span>}
          </span>
        )}
      </div>
    </header>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Content -->
    <div class="prose prose-gray prose-lg max-w-none
      prose-headings:text-secondary prose-headings:font-bold
      prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-gray-200
      prose-h3:text-xl prose-h3:mt-8
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-table:text-sm
      prose-th:bg-gray-50 prose-th:font-semibold
      prose-td:border-gray-200 prose-th:border-gray-200
      prose-blockquote:border-l-primary prose-blockquote:bg-red-50/30 prose-blockquote:py-1 prose-blockquote:rounded-r-md
      prose-code:text-primary prose-code:bg-red-50 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
      prose-strong:text-gray-900
      prose-li:marker:text-primary">
      <slot />
    </div>

    {hasFaqs && (
      <section class="mt-12 pt-8 border-t border-gray-200" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="text-2xl font-bold text-secondary mb-6">Frequently Asked Questions</h2>
        <dl class="space-y-6">
          {faqs!.map((f) => (
            <div>
              <dt class="font-semibold text-gray-900">{f.q}</dt>
              <dd class="mt-1 text-gray-700 leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {relatedLinks.length > 0 && (
      <section class="mt-12 pt-8 border-t border-gray-200" aria-labelledby="related-heading">
        <h2 id="related-heading" class="text-2xl font-bold text-secondary mb-6">Related Guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedLinks.map((link) => (
            <GuideCard
              title={link.title}
              href={link.href}
              description={link.description}
              lastVerified={link.lastVerified}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
