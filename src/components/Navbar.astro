---
const currentPath = Astro.url.pathname;

// Primary destinations. Active state drives both the colour change and the
// programmatic `aria-current` signal, so assistive tech learns the current
// section instead of relying on colour alone.
const links = [
  { href: '/guides/', label: 'Guides', match: '/guides' },
  { href: '/apps/', label: 'Apps', match: '/apps' },
  { href: '/checklist/', label: 'Checklist', match: '/checklist' },
];

const isActive = (match: string) => currentPath.startsWith(match);
const searchActive = currentPath.startsWith('/search');
---

<nav class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm" aria-label="Main navigation">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 text-secondary font-bold text-lg tracking-tight" aria-label="ChinaGuide.ai home">
        <span class="text-primary text-xl" aria-hidden="true">&#x2766;</span>
        ChinaGuide.ai
      </a>

      <div class="flex items-center gap-6">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.match) ? 'page' : undefined}
            class:list={["text-sm font-medium transition-colors hover:text-primary", isActive(link.match) ? 'text-primary' : 'text-gray-600']}
          >
            {link.label}
          </a>
        ))}
        <a
          href="/search/"
          aria-current={searchActive ? 'page' : undefined}
          class:list={["text-sm font-medium transition-colors hover:text-primary", searchActive ? 'text-primary' : 'text-gray-600']}
          aria-label="Search"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>
