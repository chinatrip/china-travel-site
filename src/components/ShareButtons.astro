---
// Page share component with UTM attribution. Two placements via `variant`:
//   - 'inline' — compact icon-only buttons in the header meta-row (ml-auto).
//   - 'card'   — bordered "Found this guide helpful?" card after the article body.
// Channels (in order): WhatsApp, Reddit, X, Email, Copy link.
//
// SEO contract: the share links carry ?utm_* but the page's own
// <link rel="canonical"> stays clean — this component never emits a canonical
// and the `url` passed in is the clean canonical URL; UTMs are only appended to
// the outbound share targets, never to the page itself.
//
// No third-party scripts, no cookies. The four target links are plain
// <a target="_blank" rel="noopener"> and work without JS. Copy + native Web
// Share are progressive enhancement via a tiny inline module script.

interface Props {
  /** Clean canonical page URL (pass GuideLayout's canonicalURL). */
  url: string;
  /** Page title, used in share text/subject. */
  title: string;
  /** 'inline' (header meta-row) | 'card' (end-of-article). */
  variant: 'inline' | 'card';
}

const { url, title, variant } = Astro.props;

// Campaign slug = last non-empty path segment of the canonical URL
// (e.g. https://chinaguide.ai/apps/alipay/ → "alipay").
function campaignSlug(pageUrl: string): string {
  try {
    const segments = new URL(pageUrl).pathname.split('/').filter(Boolean);
    return segments[segments.length - 1] ?? '';
  } catch {
    return '';
  }
}
const slug = campaignSlug(url);

// Build the page share URL with the baked-in UTM scheme for a given source.
// utm_medium is constant ("share"); utm_campaign is the page slug.
function shareUrlFor(source: string): string {
  const u = new URL(url);
  u.searchParams.set('utm_source', source);
  u.searchParams.set('utm_medium', 'share');
  u.searchParams.set('utm_campaign', slug);
  return u.href;
}

const waUrl = shareUrlFor('whatsapp');
const redditUrl = shareUrlFor('reddit');
const xUrl = shareUrlFor('x');
const emailUrl = shareUrlFor('email');
const copyUrl = shareUrlFor('copy');
const nativeShareUrl = shareUrlFor('share');

// Target intent URLs (per spec). encodeURIComponent everywhere.
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${title} ${waUrl}`)}`;
const redditHref = `https://www.reddit.com/submit?url=${encodeURIComponent(redditUrl)}&title=${encodeURIComponent(title)}`;
const xHref = `https://twitter.com/intent/tweet?url=${encodeURIComponent(xUrl)}&text=${encodeURIComponent(title)}`;
const emailHref = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(emailUrl)}`;

const isCard = variant === 'card';

// Shared button styling, matching the Navbar/Badge idiom: gray default,
// hover → primary red on a light red background with a red ring.
const btnBase =
  'inline-flex items-center justify-center gap-2 rounded-md border border-gray-200 bg-white text-gray-600 font-semibold transition-colors hover:text-primary hover:bg-red-50 hover:border-red-300';
// Inline = icon-only, fixed square; card = taller with text label padding.
const btnSize = isCard ? 'h-9 px-3 text-sm' : 'h-8 w-8 text-sm';
const btnClass = `${btnBase} ${btnSize}`;
const iconClass = 'w-[17px] h-[17px] shrink-0';
---

<div
  class:list={[
    'share-buttons',
    isCard
      ? 'mt-8 rounded-xl border border-gray-200 bg-gradient-to-b from-white to-surface px-5 py-5'
      : 'inline-flex items-center gap-1 sm:ml-auto',
  ]}
  data-share-variant={variant}
  data-share-url={copyUrl}
  data-share-title={title}
  data-native-share-url={nativeShareUrl}
>
  {isCard ? (
    <>
      <h2 class="flex items-center gap-2 text-base font-bold text-secondary">
        <svg class="w-[18px] h-[18px] text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 20.5l-1.45-1.32C5.4 14.36 2 11.28 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.78-3.4 6.86-8.55 11.68L12 20.5z" />
        </svg>
        Found this guide helpful?
      </h2>
      <p class="mt-1 mb-4 text-sm text-gray-600">Share it with fellow travelers heading to China.</p>
      <div class="flex flex-wrap items-center gap-2">
        <a href={whatsappHref} target="_blank" rel="noopener" class={btnClass} aria-label="Share on WhatsApp">
          <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" /></svg>
          <span>WhatsApp</span>
        </a>
        <a href={redditHref} target="_blank" rel="noopener" class={btnClass} aria-label="Share on Reddit">
          <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 11.779c0-1.459-1.192-2.645-2.657-2.645-.715 0-1.363.286-1.84.746-1.81-1.191-4.259-1.949-6.971-2.046l1.483-4.669 4.016.941-.006.058c0 1.193.975 2.163 2.174 2.163 1.198 0 2.172-.97 2.172-2.163s-.975-2.164-2.172-2.164c-.92 0-1.704.574-2.021 1.379l-4.329-1.015c-.189-.046-.381.063-.44.249l-1.654 5.207c-2.838.034-5.409.798-7.3 2.025-.474-.438-1.103-.712-1.799-.712-1.465 0-2.656 1.187-2.656 2.646 0 1.026.59 1.911 1.449 2.347-.38.516-.583 1.103-.583 1.713 0 3.318 4.029 6.017 8.983 6.017s8.982-2.699 8.982-6.017c0-.605-.201-1.187-.575-1.7.866-.434 1.464-1.322 1.464-2.36zm-16.288 1.984c0-.829.679-1.504 1.515-1.504.836 0 1.515.675 1.515 1.504s-.679 1.504-1.515 1.504c-.836 0-1.515-.675-1.515-1.504zm8.722 4.984c-.91.902-2.642.973-3.149.973-.507 0-2.24-.07-3.148-.973-.135-.134-.135-.353 0-.488.134-.133.353-.133.488 0 .573.57 1.798.771 2.66.771.862 0 2.088-.201 2.661-.771.135-.133.354-.133.488 0 .135.135.135.354 0 .488zm-.227-3.48c-.836 0-1.515-.675-1.515-1.504s.679-1.504 1.515-1.504c.836 0 1.515.675 1.515 1.504s-.679 1.504-1.515 1.504z" /></svg>
          <span>Reddit</span>
        </a>
        <a href={xHref} target="_blank" rel="noopener" class={btnClass} aria-label="Share on X">
          <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
          <span>X</span>
        </a>
        <a href={emailHref} class={btnClass} aria-label="Share via Email">
          <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          <span>Email</span>
        </a>
        <button type="button" class={btnClass} data-share-action="copy" aria-label="Copy link">
          <svg class:list={[iconClass, 'share-copy-icon']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
          <span class="share-copy-label">Copy link</span>
        </button>
      </div>
    </>
  ) : (
    <>
      <span class="mr-1 text-xs font-medium text-muted">Share</span>
      <a href={whatsappHref} target="_blank" rel="noopener" class={btnClass} aria-label="Share on WhatsApp" title="WhatsApp">
        <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" /></svg>
      </a>
      <a href={redditHref} target="_blank" rel="noopener" class={btnClass} aria-label="Share on Reddit" title="Reddit">
        <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 11.779c0-1.459-1.192-2.645-2.657-2.645-.715 0-1.363.286-1.84.746-1.81-1.191-4.259-1.949-6.971-2.046l1.483-4.669 4.016.941-.006.058c0 1.193.975 2.163 2.174 2.163 1.198 0 2.172-.97 2.172-2.163s-.975-2.164-2.172-2.164c-.92 0-1.704.574-2.021 1.379l-4.329-1.015c-.189-.046-.381.063-.44.249l-1.654 5.207c-2.838.034-5.409.798-7.3 2.025-.474-.438-1.103-.712-1.799-.712-1.465 0-2.656 1.187-2.656 2.646 0 1.026.59 1.911 1.449 2.347-.38.516-.583 1.103-.583 1.713 0 3.318 4.029 6.017 8.983 6.017s8.982-2.699 8.982-6.017c0-.605-.201-1.187-.575-1.7.866-.434 1.464-1.322 1.464-2.36zm-16.288 1.984c0-.829.679-1.504 1.515-1.504.836 0 1.515.675 1.515 1.504s-.679 1.504-1.515 1.504c-.836 0-1.515-.675-1.515-1.504zm8.722 4.984c-.91.902-2.642.973-3.149.973-.507 0-2.24-.07-3.148-.973-.135-.134-.135-.353 0-.488.134-.133.353-.133.488 0 .573.57 1.798.771 2.66.771.862 0 2.088-.201 2.661-.771.135-.133.354-.133.488 0 .135.135.135.354 0 .488zm-.227-3.48c-.836 0-1.515-.675-1.515-1.504s.679-1.504 1.515-1.504c.836 0 1.515.675 1.515 1.504s-.679 1.504-1.515 1.504z" /></svg>
      </a>
      <a href={xHref} target="_blank" rel="noopener" class={btnClass} aria-label="Share on X" title="X">
        <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
      </a>
      <a href={emailHref} class={btnClass} aria-label="Share via Email" title="Email">
        <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
      </a>
      <button type="button" class:list={[btnClass, 'share-copy-btn']} data-share-action="copy" aria-label="Copy link" title="Copy link">
        <svg class:list={[iconClass, 'share-copy-icon']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
      </button>
      {/* Native Web Share — hidden by default, revealed by the script on
          devices that support navigator.share. Mobile-first prominence. */}
      <button
        type="button"
        class="share-native-btn hidden inline-flex items-center gap-2 h-8 px-3 text-sm font-semibold rounded-md border border-primary bg-primary text-white transition-colors hover:bg-red-700"
        data-share-action="native"
        aria-label="Share this guide"
      >
        <svg class={iconClass} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13" /><path d="m7 8 5-5 5 5" /><path d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg>
        <span>Share this guide</span>
      </button>
    </>
  )}
</div>

<script>
  // Progressive enhancement, no third-party code, no cookies.
  // 1) Copy buttons copy the page share URL (utm_source=copy) and flash a
  //    green "Copied!" state for ~2s.
  // 2) On devices with navigator.share, reveal the prominent native button.
  function initShareButtons() {
    const roots = document.querySelectorAll<HTMLElement>('.share-buttons');
    roots.forEach((root) => {
      const copyUrl = root.dataset.shareUrl || '';
      const title = root.dataset.shareTitle || '';
      const nativeUrl = root.dataset.nativeShareUrl || '';

      // --- Copy link ---
      root.querySelectorAll<HTMLButtonElement>('[data-share-action="copy"]').forEach((btn) => {
        const label = btn.querySelector('.share-copy-label');
        const originalLabel = label?.textContent || '';
        let resetTimer: ReturnType<typeof setTimeout> | undefined;
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(copyUrl);
          } catch {
            return; // clipboard blocked (e.g. insecure context) — leave link buttons as the fallback
          }
          btn.classList.add('!text-green-700', '!bg-green-50', '!border-green-300');
          if (label) label.textContent = 'Copied!';
          if (resetTimer) clearTimeout(resetTimer);
          resetTimer = setTimeout(() => {
            btn.classList.remove('!text-green-700', '!bg-green-50', '!border-green-300');
            if (label) label.textContent = originalLabel;
          }, 2000);
        });
      });

      // --- Native Web Share ---
      if (typeof navigator !== 'undefined' && 'share' in navigator) {
        root.querySelectorAll<HTMLButtonElement>('.share-native-btn').forEach((btn) => {
          btn.classList.remove('hidden');
          btn.addEventListener('click', async () => {
            try {
              await navigator.share({ title, url: nativeUrl });
            } catch {
              /* user dismissed or share failed — no-op */
            }
          });
        });
      }
    });
  }

  initShareButtons();
  document.addEventListener('astro:page-load', initShareButtons);
</script>
